  {
    "id": "C05",
    "title": "Password reset through the assistant",
    "language": "en",
    "kind": "action",
    "outcome": "action_done",
    "turns": [
      {
        "say": "I forgot my password and can't log in.",
        "expect": {
          "route": "action",
          "tool": "reset_password",
          "pending_confirmation": true
        }
      },
      {
        "say": "yes",
        "expect": {
          "tool_result_has": [
            "email",
            "expires_in_minutes"
